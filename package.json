{
  "name": "@consail-labs/consail-mcp",
  "version": "0.1.0",
  "description": "Governed Consail MCP server (stdio) - agents operate Consail without a database password",
  "type": "module",
  "bin": {
    "consail-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "consail",
    "mcp",
    "model-context-protocol"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/consail-labs/consail-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "koffi": "^3.3.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
